-- ==========================================
-- ЗМЕЙКА для BrickLua (Сетка 10x20, без рамки)
-- ==========================================

-- 1. Инициализация переменных
local snake = {{4, 10}, {3, 10}, {2, 10}}
local dir_x = 1
local dir_y = 0
local food_x, food_y
local score = 0
local timer = 0
local speed = 10
local game_over = false
local can_restart = false

-- 2. Вспомогательные функции
local function is_snake(x, y)
    for _, s in ipairs(snake) do
        if s[1] == x and s[2] == y then return true end
    end
    return false
end

local function spawn_food()
    repeat
        -- Теперь еда может появиться где угодно на поле 10x20
        food_x = math.random(0, 9)
        food_y = math.random(0, 19)
    until not is_snake(food_x, food_y)
end

local function draw_game()
    cls() -- Очищаем экран (рамку больше не рисуем)

    -- Рисуем еду
    bset(food_x, food_y)

    -- Рисуем змейку
    for _, segment in ipairs(snake) do
        bset(segment[1], segment[2])
    end

    -- Выводим интерфейс справа
    print("SNAKE", 2, 10)
    print("SCORE", 2, 30)
    print(tostring(score), 2, 36)
    print("LENGTH", 2, 50)
    print(tostring(#snake), 2, 56)
end

-- 3. Первый спавн еды
spawn_food()

-- 4. Главный цикл
function BRICK()
    if game_over then
        cls()
        print("GAME OVER", 2, 40)
        print("SCORE:", 2, 50)
        print(tostring(score), 2, 56)
        print("PRESS A", 2, 70)
        
        if btn(4) then 
            if can_restart then
                snake = {{4, 10}, {3, 10}, {2, 10}}
                dir_x, dir_y = 1, 0
                score = 0
                game_over = false
                can_restart = false
                speed = 10
                spawn_food()
                beep(440, 5, 50)
            end
        else
            can_restart = true
        end
        return
    end

    -- Обработка ввода (нельзя развернуться на 180 градусов)
    if btn(2) and dir_y == 0 then dir_x, dir_y = 0, -1 end
    if btn(3) and dir_y == 0 then dir_x, dir_y = 0, 1 end
    if btn(0) and dir_x == 0 then dir_x, dir_y = -1, 0 end
    if btn(1) and dir_x == 0 then dir_x, dir_y = 1, 0 end

    -- Движение по таймеру
    timer = timer + 1
    if timer < speed then
        draw_game()
        return
    end
    timer = 0

    -- Логика движения
    local head = snake[1]
    local new_head_x = head[1] + dir_x
    local new_head_y = head[2] + dir_y

    -- Проверка на столкновение со стенами (теперь границы от 0 до 9 и от 0 до 19)
    if new_head_x < 0 or new_head_x > 9 or new_head_y < 0 or new_head_y > 19 then
        game_over = true
        beep(150, 20, 100)
        return
    end

    -- Проверка на столкновение с собой
    for _, segment in ipairs(snake) do
        if segment[1] == new_head_x and segment[2] == new_head_y then
            game_over = true
            beep(150, 20, 100)
            return
        end
    end

    -- Добавляем новую голову
    table.insert(snake, 1, {new_head_x, new_head_y})

    -- Проверка на поедание еды
    if new_head_x == food_x and new_head_y == food_y then
        score = score + 10
        beep(880, 5, 50)
        spawn_food()
        
        if score % 50 == 0 and speed > 4 then
            speed = speed - 1
        end
    else
        table.remove(snake)
    end

    draw_game()
end