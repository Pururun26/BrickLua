-- Инициализация переменных
local snake = {{10, 10}, {9, 10}, {8, 10}} -- Старт в центре
local dir_x = 1
local dir_y = 0
local food_x = 15
local food_y = 15
local score = 0
local timer = 0
local speed = 10 -- Чем меньше, тем быстрее
local game_over = false
local can_restart = false

function BRICK()
    if game_over then
        cls()
        -- Текст теперь выводится в правой панели (x=0 это её начало)
        print("GAME OVER", 2, 40, 1)
        print("SCORE:", 2, 50, 1)
        print(tostring(score), 2, 56, 1)
        print("PRESS A", 2, 70, 1)
        
        -- Защита от автоповтора кнопки при рестарте
        if btn(4) then 
            if can_restart then
                -- Сброс игры
                snake = {{10, 10}, {9, 10}, {8, 10}}
                dir_x, dir_y = 1, 0
                score = 0
                game_over = false
                can_restart = false
                beep(440, 5, 50)
            end
        else
            can_restart = true
        end
        return
    end

    -- 1. Обработка ввода (нельзя развернуться на 180 градусов)
    if btn(2) and dir_y == 0 then dir_x, dir_y = 0, -1 end -- Вверх
    if btn(3) and dir_y == 0 then dir_x, dir_y = 0, 1 end  -- Вниз
    if btn(0) and dir_x == 0 then dir_x, dir_y = -1, 0 end -- Влево
    if btn(1) and dir_x == 0 then dir_x, dir_y = 1, 0 end  -- Вправо

    -- 2. Движение по таймеру
    timer = timer + 1
    if timer < speed then
        draw_game()
        return
    end
    timer = 0

    -- 3. Логика движения
    local head = snake[1]
    local new_head_x = head[1] + dir_x
    local new_head_y = head[2] + dir_y

    -- Проверка на столкновение со стенами (игровое поле от 1 до 18)
    if new_head_x < 1 or new_head_x > 18 or new_head_y < 1 or new_head_y > 18 then
        game_over = true
        beep(150, 20, 100) -- Звук проигрыша
        return
    end

    -- Проверка на столкновение с собой
    for i, segment in ipairs(snake) do
        if segment[1] == new_head_x and segment[2] == new_head_y then
            game_over = true
            beep(150, 20, 100)
            return
        end
    end

    -- Добавляем новую голову
    table.insert(snake, 1, {new_head_x, new_head_y})

    -- Проверка на поедание еды
    if new_head_x == food_x and new_head_y == food_y then
        score = score + 10
        beep(880, 5, 50) -- Звук поедания
        
        -- Генерируем новую еду (от 1 до 18)
        repeat
            food_x = math.random(1, 18)
            food_y = math.random(1, 18)
        until not is_snake(food_x, food_y)
        
        -- Ускоряем игру каждые 50 очков (опционально)
        if score % 50 == 0 and speed > 4 then
            speed = speed - 1
        end
    else
        -- Если не съели, удаляем хвост
        table.remove(snake)
    end

    draw_game()
end

function is_snake(x, y)
    for _, s in ipairs(snake) do
        if s[1] == x and s[2] == y then return true end
    end
    return false
end

function draw_game()
    -- Очищаем весь экран
    cls()

    -- Рисуем рамку (стены от 0 до 19)
    for i = 0, 19 do
        bset(i, 0, 1)
        bset(i, 19, 1)
        bset(0, i, 1)
        bset(19, i, 1)
    end

    -- Рисуем еду
    bset(food_x, food_y, 1)

    -- Рисуем змейку
    for i, segment in ipairs(snake) do
        bset(segment[1], segment[2], 1)
    end

    -- Выводим интерфейс справа
    print("SNAKE", 2, 10, 1)
    print("SCORE", 2, 30, 1)
    print(tostring(score), 2, 36, 1)
    
    print("LENGTH", 2, 50, 1)
    print(tostring(#snake), 2, 56, 1)
end