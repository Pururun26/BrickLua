-- >>> init.lua
function init_game()
    math.randomseed(utime())

    player = {}
    player.x = 9
    player.y = 15
    player.w = 1
    player.h = 1
    player.sx = 0
    player.sy = 0

    -- ENEMIES --
    enemies = {}

    local my_enemy = {}
    my_enemy.x = math.random(0, 19)
    my_enemy.y = 1

    my_enemy.sx = math.random(-1, 1)
    if my_enemy.sx == 0 then my_enemy.sx = 1 end

    my_enemy.sy = math.random(-1, 1)
    if my_enemy.sy == 0 then my_enemy.sy = 1 end

    my_enemy.w = 2
    my_enemy.h = 2

    table.insert(enemies, my_enemy)
    score = #enemies

    high_score = dget(0)

    -- timer_spawn_enemy
    ts_enemy = 0
    enemy_frame = 0
    -- timer_move_enemies
    tm_enemies = 0

    mode = "START"

    -- blink
    blinkt = 1
    blink_flame = 0

    -- blink player
    blink_playert = 1
    bf_player = 0 -- blink flame player
end
-- <<< init.lua
-- >>> update.lua
function update_start()
    if btn(4) then
        init_game()
        mode = "GAME"
    end

    tm_enemies = tm_enemies + 1
    if tm_enemies >= 15 then
        tm_enemies = 0
        anim_screen()
    end
end

function update_game()
    player.sx = 0
    player.sy = 0

    if btn(0) then player.sx = -1 end
    if btn(1) then player.sx =  1 end
    if btn(2) then player.sy = -1 end
    if btn(3) then player.sy =  1 end

    player.x = player.x + player.sx
    player.y = player.y + player.sy

    -- CHECK FOR COLLISION WITH THE SCREEN EDGES --
    if player.x > 19 then player.x = 19 end
    if player.x < 0  then player.x = 0  end
    if player.y > 19 then player.y = 19 end
    if player.y < 0  then player.y = 0  end

    enemy_spawn()

    tm_enemies = tm_enemies + 1
    if tm_enemies >= 15 then
        tm_enemies = 0
        update_enemies()
    end
end

function update_over()
    if btn(4) then init_game() end
end


function update_enemies()
    -- 1) движение и отбивание от стен
    for i, e in ipairs(enemies) do
        e.x = e.x + e.sx
        e.y = e.y + e.sy

        if collision_rect(player, e) then
            if score > high_score then
                high_score = score
                dset(0, high_score)
            end
            mode = "OVER"
        end

        if e.x > 18 then
            e.sx = -e.sx
            e.x = 18
            beep(440, 1, 90)
        end
        if e.x < 1 then
            e.sx = math.abs(e.sx)
            e.x = 0
            beep(440, 1, 90)
        end
        if e.y > 18 then
            e.sy = -e.sy
            e.y = 18
            beep(440, 1, 90)
        end
        if e.y < 1 then
            e.sy = math.abs(e.sy)
            e.y = 0
            beep(440, 1, 90)
        end
    end

    -- 2) столкновения врагов друг с другом
    for i = 1, #enemies - 1 do
        local a = enemies[i]
        for j = i + 1, #enemies do
            local b = enemies[j]

            if collision_rect(a, b) then
                beep(440, 1, 90)
                -- центры
                local acx, acy = a.x + a.w / 2, a.y + a.h / 2
                local bcx, bcy = b.x + b.w / 2, b.y + b.h / 2

                -- перекрытие по осям
                local overlap_x = (a.w + b.w) / 2 - math.abs(acx - bcx)
                local overlap_y = (a.h + b.h) / 2 - math.abs(acy - bcy)

                if overlap_x < overlap_y then
                    -- столкнулись по горизонтали
                    a.sx, b.sx = b.sx, a.sx

                    -- раздвигаем ровно на overlap_x, целыми числами
                    local push_a = math.ceil(overlap_x / 2)
                    local push_b = math.floor(overlap_x / 2)

                    if acx < bcx then
                        a.x = a.x - push_a
                        b.x = b.x + push_b
                    else
                        a.x = a.x + push_a
                        b.x = b.x - push_b
                    end
                else
                    -- столкнулись по вертикали
                    a.sy, b.sy = b.sy, a.sy

                    local push_a = math.ceil(overlap_y / 2)
                    local push_b = math.floor(overlap_y / 2)

                    if acy < bcy then
                        a.y = a.y - push_a
                        b.y = b.y + push_b
                    else
                        a.y = a.y + push_a
                        b.y = b.y - push_b
                    end
                end
            end
        end
    end
end
-- <<< update.lua
-- >>> draw.lua
function draw_start()
    -- DRAW ENEMIES --
    for i, my_enemy in ipairs(enemies) do
        rect(my_enemy.x, my_enemy.y, my_enemy.w, my_enemy.h, true)
    end

    print("DODGE BRICKS", 15, 40)
    print("HIGH SCORE:"..high_score, 2, 2)
    print("SCORE:"..score-1, 2, 8)

    if blink_test() then
        print("PRESS (Z/J) TO START", 3, 80)
    end
end

function draw_game()
    if blink_player() then bset(player.x, player.y) end

    -- DRAW ENEMIES --
    for i, my_enemy in ipairs(enemies) do
        rect(my_enemy.x, my_enemy.y, my_enemy.w, my_enemy.h, true)
    end

    print("SCORE:"..#enemies, 2, 2)
end

function draw_over()
    print("GAME OVER", 22, 40)
    print("PRESS (Z/J)", 15, 80)
    print("TO CONTINUE", 22, 85)
end
-- <<< draw.lua
-- >>> tools.lua
function enemy_spawn()
    enemy_frame = enemy_frame + 1

    if enemy_frame >= 30 then
        enemy_frame = 0
        ts_enemy = ts_enemy + 1
        if ts_enemy > 5 then
            ts_enemy = 0
            
            -- SPAWN ENEMY --
            local my_enemy = {}
            my_enemy.x = math.random(0, 18)
            my_enemy.y = 1

            my_enemy.sx = math.random(-1, 1)
            if my_enemy.sx == 0 then my_enemy.sx = 1 end

            my_enemy.sy = math.random(-1, 1)
            if my_enemy.sy == 0 then my_enemy.sy = 1 end

            my_enemy.w = 2
            my_enemy.h = 2

            table.insert(enemies, my_enemy)
            score = #enemies
        end
    end

    -- return ts_enemy
end


function blink_test()
    local baim = { true, true, true, true, true, false }

    blink_flame = blink_flame + 1
    if blink_flame > 6 then
        blink_flame = 0
        if blinkt >= #baim then
            blinkt = 1
        else
            blinkt = blinkt + 1
        end
    end

    return baim[blinkt]
end


function blink_player()
    local baim = {true, false }

    bf_player = bf_player + 1
    if bf_player > 2 then
        bf_player = 0
        if blink_playert >= #baim then
            blink_playert = 1
        else
            blink_playert = blink_playert + 1
        end
    end

    return baim[blink_playert]
end


function anim_screen()
    -- 1) движение и отбивание от стен
    for i, e in ipairs(enemies) do
        e.x = e.x + e.sx
        e.y = e.y + e.sy

        if e.x > 18 then
            e.sx = -e.sx
            e.x = 18
            beep(440, 1, 90)
        end
        if e.x < 1 then
            e.sx = math.abs(e.sx)
            e.x = 0
            beep(440, 1, 90)
        end
        if e.y > 18 then
            e.sy = -e.sy
            e.y = 18
            beep(440, 1, 90)
        end
        if e.y < 1 then
            e.sy = math.abs(e.sy)
            e.y = 0
            beep(440, 1, 90)
        end
    end
end
-- <<< tools.lua
-- >>> collision.lua
function collision_rect(a, b)
    -- TABLE A AND B --
    local a_left = a.x
    local a_top = a.y
    local a_right = a.x + a.w - 1
    local a_bottom = a.y + a.h - 1

    local b_left = b.x
    local b_top = b.y
    local b_right = b.x + b.w - 1
    local b_bottom = b.y + b.h - 1

    if a_left > b_right then return false end
    if b_left > a_right then return false end
    if a_top > b_bottom then return false end
    if b_top > a_bottom then return false end

    return true
end
-- <<< collision.lua

init_game()
function BRICK()
    cls()
    if mode == "START" then
        update_start()
        draw_start()
    elseif mode == "GAME" then
        update_game()
        draw_game()
    elseif mode == "OVER" then
        update_over()
        draw_over()
    end
end
