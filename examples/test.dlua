function update()
    -- 1. Обработка ввода
    if btnp(0) then -- Нажали Влево
        beep(440, 5, 50)
    end

    -- 2. Очистка только игрового поля (левая часть 96x96)
    -- Правую панель не трогаем — там текст, перерисуем его ниже
    cls()

    -- 3. Рисуем рамку вокруг поля кубиками
    for i = 0, 11 do
        pset(i, 0, 1)    -- верх
        pset(i, 11, 1)   -- низ
        pset(0, i, 1)    -- лево
        pset(11, i, 1)   -- право
    end

    -- 4. Рисуем точку в центре
    pset(5, 5, 1)

    -- 5. Пишем текст справа (в зоне UI, начиная с x=98)
    -- Перерисовываем каждый кадр, потому что cls_grid не трогал текст,
    -- но мы хотим, чтобы цифры обновлялись
    print("DOTLUA",  98, 10, 1)
    print("FPS: 30", 98, 20, 1)
end